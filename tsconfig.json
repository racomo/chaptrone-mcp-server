{
  "compilerOptions": {
    "target": "ES2020",
    "lib": ["ES2021", "DOM"],
    "module": "Node16",
    "moduleResolution": "Node16",
    "outDir": "dist",
    "rootDir": "src",
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,

    "strict": false,
    "noImplicitAny": false,
    "noEmitOnError": false
  },
  "include": ["src/server.ts"],
  "exclude": ["node_modules", "dist"]
}
